# ============================================================
#  DCAD GIS Platform — Environment Configuration
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git.
# ============================================================

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=arcgis_spatial

# --- FastAPI / JWT ---
JWT_SECRET=replace_with_long_random_string

# NOTE: SPATIAL_DB_URL / BUSINESS_DB_URL are constructed automatically by
# docker-compose.yml from the values above — you do not need to set them here
# unless running the ETL scripts directly on the host (outside Docker):
# SPATIAL_DB_URL=postgresql://postgres:<password>@localhost:5432/arcgis_spatial
# BUSINESS_DB_URL=postgresql://postgres:<password>@localhost:5432/arcgis_spatial

# --- ETL Geodatabase Path (only needed when running ETL locally, not in Docker) ---
# RAW_SHAPEFILE_PATH=./etl/data/tablejoiner/tablejoiner.gdb/dcad_parcels
